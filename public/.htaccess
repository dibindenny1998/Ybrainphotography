# Ybrain Photography — Hostinger / Apache settings

RewriteEngine On

# One address for Google: send www. and the temporary Hostinger address to https://ybrainphotography.com
RewriteCond %{HTTP_HOST} ^www\.ybrainphotography\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} \.hostingersite\.com$ [NC]
RewriteRule ^(.*)$ https://ybrainphotography.com/$1 [L,R=301]

# Always use HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Photos uploaded from the admin panel live outside public_html; this serves them
RewriteRule ^media/(u/[a-f0-9]{20}-[0-9]{2,4}\.(webp|jpg))$ api/media.php?f=$1 [L,QSA]

DirectoryIndex index.html index.php

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Long cache for fingerprinted build assets, short cache for HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404.html
