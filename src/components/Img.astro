---
/**
 * <Img slot="weddings-03" /> — renders a photo from src/photos/.
 * `fit="cover"` fills a fixed frame by cropping (never stretching);
 * otherwise the image keeps its own natural proportions.
 */
import { photo as getPhoto, type Photo } from '../lib/photos';
interface Props {
  slot?: string;
  photo?: Photo;
  sizes?: string;
  eager?: boolean;
  fit?: 'cover' | 'natural';
  class?: string;
  alt?: string;
  [k: string]: any;
}
const { slot, photo: given, sizes = '(min-width: 1024px) 40vw, 90vw', eager = false, fit = 'natural', class: cls, alt, ...rest } = Astro.props;
const p = given ?? (await getPhoto(slot!));
---
<img
  src={p.src}
  srcset={p.srcset}
  sizes={p.srcset ? sizes : undefined}
  width={p.width}
  height={p.height}
  alt={alt ?? p.alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class:list={['img', `img--${fit}`, cls]}
  draggable="false"
  {...rest}
/>
