---
/** Featured stories — full-screen cards that stack over each other as you scroll */
import Img from './Img.astro';
import Arrow from './icons/Arrow.astro';
import { stories } from '../data/site';
---
<section class="stories is-dark" id="stories" data-theme="dark" aria-labelledby="stories-title">
  <div class="lamp" data-lamp></div>
  <header class="stories__intro wrap">
    <p class="eyebrow"><span class="eyebrow__n">iv.</span><span data-scramble>Featured stories</span></p>
    <h2 id="stories-title" class="display stories__title" data-split>Whole days,<br /><em>told whole.</em></h2>
    <p class="stories__lede">
      A wedding isn't one photograph. It's the 5am oil bath, the nervous uncle, the sadya, the drive home in silence.
      Here are a few days we were trusted with.
    </p>
  </header>

  <div class="stack" data-stack>
    {stories.map((s, i) => (
      <article class="scard" data-scard style={`--i:${i}`}>
        <div class="scard__inner" data-scard-inner>
          <div class="scard__bg" data-scard-bg>
            <Img slot={`${s.slot}-cover`} fit="cover" sizes="100vw" />
          </div>
          <div class="scard__shade"></div>
          <span class="scard__num" aria-hidden="true">0{i + 1}</span>
          <div class="scard__detail" data-scard-detail>
            <Img slot={`${s.slot}-detail`} fit="cover" sizes="(min-width: 1024px) 20vw, 36vw" />
          </div>
          <div class="scard__text wrap">
            <p class="scard__type label"><span class="serif">No. 0{i + 1}</span> — {s.type}</p>
            <h3 class="scard__names">
              {s.couple.length > 1 ? (<>{s.couple[0]} <em>&amp;</em> {s.couple[1]}</>) : s.couple[0]}
            </h3>
            <p class="scard__place label">{s.place} <span class="scard__star">✦</span> {s.date}</p>
            <p class="scard__excerpt">{s.excerpt}</p>
            <a href="#enquire" class="arrow-link scard__cta" data-enquire-type={i === 3 ? 'Newborn' : 'Wedding'}><span>Plan a day like this</span><Arrow /></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style is:global>
  .stories { padding-top: clamp(96px, 14vw, 180px); }
  .stories__intro { display: grid; gap: 26px; padding-bottom: clamp(48px, 8vw, 100px); }
  .stories__title { font-size: clamp(3.2rem, 11vw, 9rem); }
  .stories__lede { margin: 0; max-width: 42ch; color: rgba(246, 233, 218, 0.7); font-size: 15px; }
  @media (min-width: 1024px) {
    .stories__intro { grid-template-columns: 1.4fr 1fr; align-items: end; }
    .stories__intro .eyebrow { grid-column: 1 / -1; }
  }

  .stack { position: relative; }
  .scard { position: sticky; top: 0; height: 100svh; padding: clamp(10px, 1.6vw, 22px); }
  .scard__inner {
    position: relative; height: 100%; border-radius: clamp(10px, 1.4vw, 20px); overflow: hidden; background: #140709;
    box-shadow: 0 -30px 80px -20px rgba(0, 0, 0, 0.7); transform-origin: 50% 0%; will-change: transform, filter;
  }
  .scard__bg { position: absolute; inset: -6% 0; }
  .scard__bg .img { width: 100%; height: 100%; object-fit: cover; }
  .scard__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 5, 6, 0.1) 0%, rgba(13, 5, 6, 0.15) 40%, rgba(20, 3, 8, 0.88) 100%), linear-gradient(90deg, rgba(13, 5, 6, 0.55), transparent 60%); }
  .scard__num {
    position: absolute; right: var(--gutter); top: clamp(70px, 9vh, 110px); font-family: var(--serif); font-style: italic; line-height: 0.8;
    font-size: clamp(6rem, 22vw, 20rem); color: transparent; -webkit-text-stroke: 1px rgba(255, 77, 102, 0.55); letter-spacing: -0.05em;
  }
  .scard__detail {
    position: absolute; right: var(--gutter); bottom: clamp(220px, 34vh, 340px); width: clamp(110px, 18vw, 260px); aspect-ratio: 4 / 5;
    border-radius: 999px 999px 6px 6px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7); outline: 1px solid rgba(255, 77, 102, 0.4); outline-offset: 6px;
  }
  .scard__detail .img { width: 100%; height: 100%; object-fit: cover; }
  .scard__text { position: absolute; left: 0; right: 0; bottom: clamp(24px, 6vh, 64px); display: grid; gap: 12px; color: var(--cream); }
  .scard__type { margin: 0; color: rgba(246, 233, 218, 0.75); }
  .scard__type .serif { font-style: italic; color: #ff4d66; letter-spacing: 0; text-transform: none; font-size: 15px; }
  .scard__names { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(3rem, 11vw, 9rem); line-height: 0.9; letter-spacing: -0.04em; max-width: 12ch; }
  .scard__names em { font-style: italic; color: #ff3d5a; text-shadow: 0 0 40px rgba(255, 40, 80, 0.5); font-size: 0.8em; }
  .scard__place { margin: 0; color: rgba(246, 233, 218, 0.75); }
  .scard__star { color: #ff4d66; }
  .scard__excerpt { margin: 0; max-width: 46ch; color: rgba(246, 233, 218, 0.8); font-size: 15px; }
  .scard__cta { color: #ff6b80; margin-top: 4px; }
  @media (max-width: 767px) {
    .scard__excerpt { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 14px; }
    .scard__detail { bottom: auto; top: clamp(80px, 12vh, 120px); left: var(--gutter); right: auto; }
  }
  .no-motion .scard { position: relative; height: 92svh; }
</style>
