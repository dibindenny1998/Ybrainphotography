---
/** Featured stories — a horizontal film strip (pinned on desktop, swipeable on phones) */
import Img from './Img.astro';
import Arrow from './icons/Arrow.astro';
import { stories } from '../data/site';
---
<section class="stories dark" id="stories" data-theme="dark" aria-labelledby="stories-title">
  <div class="stories__pin" data-stories-pin>
    <div class="stories__head wrap">
      <p class="tag">Featured stories</p>
      <h2 id="stories-title" class="display stories__title">Stories, <em>not just shots.</em></h2>
      <p class="stories__hint muted"><span class="stories__hint-d">Scroll</span><span class="stories__hint-m">Swipe</span> to explore →</p>
    </div>
    <div class="stories__viewport" data-stories-viewport>
      <div class="stories__track" data-stories-track>
        {stories.map((s, i) => (
          <article class="story" data-story>
            <div class="story__pics">
              <div class="story__main" data-story-main><Img slot={s.slots[0]} fit="cover" sizes="(min-width: 1024px) 30vw, 72vw" /></div>
              <div class="story__side">
                <div class="story__small"><Img slot={s.slots[1]} fit="cover" sizes="(min-width: 1024px) 14vw, 34vw" /></div>
                <div class="story__small"><Img slot={s.slots[2]} fit="cover" sizes="(min-width: 1024px) 14vw, 34vw" /></div>
              </div>
            </div>
            <div class="story__text">
              <p class="story__meta"><span class="story__n">0{i + 1}</span>{s.kind} · {s.place}</p>
              <h3 class="story__title">{s.title}</h3>
              <p class="story__body muted">{s.text}</p>
              <a href="#contact" class="arrow-link story__cta"><span>Book a session like this</span><Arrow /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="stories__bar wrap" aria-hidden="true"><i data-stories-progress></i></div>
  </div>
</section>

<style is:global>
  .stories { padding-block: clamp(80px, 11vw, 140px) clamp(40px, 6vw, 80px); overflow: hidden; }
  .stories__head { display: grid; gap: 18px; margin-bottom: clamp(28px, 4vw, 48px); }
  .stories__head .tag { color: var(--stone-2); }
  .stories__title { font-size: clamp(3rem, 8.5vw, 8rem); }
  .stories__title em { color: var(--accent); }
  .stories__hint { margin: 0; font-size: 13px; }
  .stories__hint-m { display: none; }
  .stories__viewport { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .stories__viewport::-webkit-scrollbar { display: none; }
  .stories__track { display: flex; gap: 18px; width: max-content; padding-inline: var(--gutter); }
  .story { flex: none; width: min(84vw, 520px); scroll-snap-align: start; display: grid; gap: 18px; }
  .story__pics { display: grid; grid-template-columns: 1.7fr 1fr; gap: 8px; }
  .story__main, .story__small { overflow: hidden; border-radius: 4px; background: var(--ink-3); }
  .story__main { aspect-ratio: 4 / 5.2; }
  .story__side { display: grid; gap: 8px; }
  .story__small { height: 100%; }
  .story .img { width: 100%; height: 100%; object-fit: cover; }
  .story__meta { margin: 0; display: flex; gap: 12px; align-items: center; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--stone-2); }
  .story__n { color: var(--accent); }
  .story__title { margin: 6px 0 8px; font-family: var(--serif); font-weight: 400; font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 0.95; letter-spacing: -0.02em; }
  .story__body { margin: 0 0 14px; font-size: 15px; max-width: 40ch; }
  .story__cta { color: var(--accent); }
  .stories__bar { margin-top: 36px; }
  .stories__bar i { display: block; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  @media (hover: none) { .stories__hint-d { display: none; } .stories__hint-m { display: inline; } }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .js .stories__pin { height: 100svh; display: flex; flex-direction: column; justify-content: center; }
    .js .stories__viewport { overflow: visible; scroll-snap-type: none; }
    .js .story { width: 58vw; grid-template-columns: 1.15fr 0.85fr; align-items: end; gap: 3vw; }
    .js .story__main { aspect-ratio: auto; height: 58svh; }
    .js .stories__track { gap: 6vw; }
    .js .stories__head { grid-template-columns: 1fr auto; align-items: end; margin-bottom: 4vh; }
    .js .stories__head .tag { grid-column: 1 / -1; }
  }
</style>
