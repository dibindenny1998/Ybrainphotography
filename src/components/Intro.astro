---
/** Statement + services index */
import Img from './Img.astro';
import Arrow from './icons/Arrow.astro';
import { categories } from '../data/site';
import { category } from '../lib/photos';
const groups = await Promise.all(categories.map(async (c) => ({ ...c, photos: await category(c.id) })));
const statement =
  'We photograph people, not poses. The *glance* nobody planned, the *laugh* in the middle of a ritual, the light that only lasts a minute, kept for the *next fifty years.*';
const words = statement.split(' ').map((w) => ({ t: w.replace(/\*/g, ''), em: w.includes('*') }));
const covers = ['portraits-03', 'couples-01', 'maternity-02', 'newborn-01', 'portraits-02', 'celebrations-02'];
---
<section class="statement section wrap" aria-labelledby="statement-title">
  <p class="tag">About the work</p>
  <h2 id="statement-title" class="sr-only">Our approach</h2>
  <p class="statement__text" data-statement>
    {words.map((w) => <><span class:list={['sw', { 'sw--em': w.em }]}>{w.t}</span>{' '}</>)}
  </p>
  <div class="statement__pics" aria-hidden="true">
    <span class="statement__pic statement__pic--a" data-speed="0.9"><Img slot="couples-03" fit="cover" alt="" sizes="(min-width: 1024px) 18vw, 40vw" /></span>
    <span class="statement__pic statement__pic--b" data-speed="1.1"><Img slot="weddings-05" fit="cover" alt="" sizes="(min-width: 1024px) 22vw, 50vw" /></span>
  </div>
</section>

<section class="services dark section" id="work" data-theme="dark" aria-labelledby="services-title">
  <div class="services__head wrap">
    <p class="tag">What we shoot</p>
    <h2 id="services-title" class="display services__title" data-split>Six ways<br />to be <em>remembered.</em></h2>
  </div>
  <ul class="services__list" data-services>
    {groups.map((g, i) => (
      <li class="srv">
        <a href="#gallery" class="srv__row wrap" data-filter-link={g.id} data-srv={g.id} data-cursor="View">
          <span class="srv__n">0{i + 1}</span>
          <span class="srv__name">{g.name}</span>
          <span class="srv__blurb muted">{g.blurb}</span>
          <span class="srv__count">{String(g.photos.length).padStart(2, '0')}</span>
          <span class="srv__thumb"><Img slot={covers[i]} fit="cover" alt="" sizes="96px" /></span>
          <Arrow class="srv__arrow" />
        </a>
      </li>
    ))}
  </ul>
  <div class="srv-float" aria-hidden="true" data-srv-float>
    {groups.map((g, i) => <div class="srv-float__img" data-srv-img={g.id}><Img slot={covers[i]} fit="cover" alt="" sizes="320px" /></div>)}
  </div>
</section>

<style is:global>
  .statement { display: grid; gap: 34px; }
  .statement__text { margin: 0; font-family: var(--serif); font-size: clamp(2.2rem, 5.6vw, 5.6rem); line-height: 1.02; letter-spacing: -0.02em; max-width: 17ch; }
  .sw--em { font-style: italic; color: var(--ink); background: linear-gradient(transparent 62%, var(--accent) 62%, var(--accent) 92%, transparent 92%); }
  .statement__pics { position: relative; display: flex; gap: 14px; align-items: flex-end; }
  .statement__pic { display: block; overflow: hidden; border-radius: 4px; }
  .statement__pic .img { width: 100%; height: 100%; object-fit: cover; }
  .statement__pic--a { width: 42%; aspect-ratio: 4 / 5; }
  .statement__pic--b { width: 54%; aspect-ratio: 1; margin-bottom: 12%; }
  @media (min-width: 1024px) {
    .statement { grid-template-columns: 1.4fr 1fr; grid-template-areas: 'tag tag' 'text pics'; column-gap: 6vw; align-items: start; }
    .statement .tag { grid-area: tag; }
    .statement__text { grid-area: text; }
    .statement__pics { grid-area: pics; margin-top: 4vw; }
  }

  .services__head { display: grid; gap: 24px; margin-bottom: clamp(40px, 6vw, 80px); }
  .services__head .tag { color: var(--stone-2); }
  .services__title { font-size: clamp(3.2rem, 9vw, 8.5rem); }
  .services__title em { color: var(--accent); }
  .services__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-d); }
  .srv { border-bottom: 1px solid var(--line-d); position: relative; overflow: hidden; }
  .srv__row { position: relative; display: grid; grid-template-columns: 36px 1fr auto; grid-template-areas: 'n name thumb' 'n blurb thumb'; column-gap: 14px; row-gap: 4px; align-items: center; padding-block: 20px; isolation: isolate; transition: color 0.4s; }
  .srv__row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--accent); transform: scaleY(0); transform-origin: bottom; transition: transform 0.5s var(--ease); }
  .srv__n { grid-area: n; align-self: start; padding-top: 0.9em; font-size: 12px; font-weight: 600; color: var(--accent); }
  .srv__name { grid-area: name; font-family: var(--serif); font-size: clamp(2.6rem, 11vw, 6.5rem); line-height: 1; letter-spacing: -0.02em; transition: transform 0.6s var(--ease); }
  .srv__blurb { grid-area: blurb; font-size: 14px; max-width: 40ch; }
  .srv__count, .srv__arrow { display: none; }
  .srv__thumb { grid-area: thumb; display: block; width: 64px; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 3px; }
  .srv__thumb .img { width: 100%; height: 100%; object-fit: cover; }
  .srv-float { display: none; }
  @media (min-width: 1024px) {
    .srv__row { grid-template-columns: 70px minmax(0, 1fr) 340px 60px 40px; grid-template-areas: 'n name blurb count arrow'; padding-block: 22px; }
    .srv__thumb { display: none; }
    .srv__count { display: block; grid-area: count; font-size: 13px; font-weight: 500; text-align: right; color: var(--stone-2); }
    .srv__arrow { display: block; grid-area: arrow; width: 28px; justify-self: end; transition: transform 0.5s var(--ease); }
    .srv__row:hover { color: var(--ink); }
    .srv__row:hover::before { transform: scaleY(1); }
    .srv__row:hover .srv__n, .srv__row:hover .srv__blurb, .srv__row:hover .srv__count { color: var(--ink); }
    .srv__row:hover .srv__name { transform: translateX(14px); font-style: italic; }
    .srv__row:hover .srv__arrow { transform: translateX(4px) rotate(-45deg); }
    .srv-float { display: block; position: fixed; left: 0; top: 0; z-index: 70; width: 240px; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 4px; pointer-events: none; opacity: 0; transform: scale(0.7); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.5); }
    .srv-float__img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.35s; }
    .srv-float__img.is-active { opacity: 1; }
    .srv-float__img .img { width: 100%; height: 100%; object-fit: cover; }
  }
</style>
