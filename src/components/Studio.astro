---
import Img from './Img.astro';
import { site, process } from '../data/site';
---
<section class="about section wrap" id="about" aria-labelledby="about-title">
  <div class="about__media">
    <div class="about__main" data-reveal-clip><Img slot="portraits-02" fit="cover" sizes="(min-width: 1024px) 34vw, 92vw" /></div>
    <div class="about__badge" aria-hidden="true">
      <span class="about__badge-n">{site.established}</span>
      <span class="about__badge-t">New studio<br />now open</span>
    </div>
  </div>
  <div class="about__copy">
    <p class="tag">About Ybrain</p>
    <h2 id="about-title" class="display about__title" data-split>Quiet eyes,<br /><em>loud colours.</em></h2>
    <p class="about__lead" data-fade-up>
      Ybrain is a small photography studio that loves real moments and bold, natural colour. We shoot weddings, couples,
      maternity, newborns and portraits, at home in Kerala and anywhere you want to go.
    </p>
    <ul class="about__facts">
      <li data-fade-up><span class="about__fact-n">6</span><span class="muted">Kinds of sessions</span></li>
      <li data-fade-up><span class="about__fact-n">∞</span><span class="muted">Travel, worldwide</span></li>
      <li data-fade-up><span class="about__fact-n">1 wk</span><span class="muted">First preview</span></li>
    </ul>
    <ol class="steps">
      {process.map((p) => (
        <li class="step" data-fade-up><span class="step__n">{p.n}</span><div><h3 class="step__t">{p.title}</h3><p class="step__p muted">{p.text}</p></div></li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .about { display: grid; gap: 48px; }
  .about__media { position: relative; }
  .about__main { overflow: hidden; border-radius: 4px; aspect-ratio: 4 / 5; }
  .about__main .img { width: 100%; height: 100%; object-fit: cover; }
  .about__badge { position: absolute; right: -6px; bottom: -26px; width: 132px; height: 132px; border-radius: 50%; background: var(--accent); display: grid; place-content: center; text-align: center; gap: 2px; transform: rotate(-8deg); }
  .about__badge-n { font-family: var(--serif); font-size: 34px; line-height: 1; }
  .about__badge-t { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.3; }
  .about__copy { display: grid; gap: 26px; align-content: start; }
  .about__title { font-size: clamp(3.2rem, 8vw, 7.4rem); }
  .about__title em { background: linear-gradient(transparent 60%, var(--accent) 60%, var(--accent) 90%, transparent 90%); }
  .about__lead { margin: 0; font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.55; max-width: 46ch; }
  .about__facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .about__facts li { display: grid; gap: 2px; padding-top: 16px; font-size: 12px; }
  .about__fact-n { font-family: var(--serif); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1; }
  .steps { list-style: none; margin: 0; padding: 0; }
  .step { display: grid; grid-template-columns: 48px 1fr; gap: 10px; padding: 18px 0; border-top: 1px solid var(--line); }
  .step:last-child { border-bottom: 1px solid var(--line); }
  .step__n { font-size: 12px; font-weight: 600; padding-top: 6px; }
  .step__t { margin: 0 0 4px; font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.05; }
  .step__p { margin: 0; font-size: 14px; max-width: 46ch; }
  @media (min-width: 1024px) {
    .about { grid-template-columns: 0.85fr 1.15fr; gap: 7vw; align-items: start; }
    .about__media { position: sticky; top: 12vh; }
    .about__main { aspect-ratio: auto; height: 76svh; }
    .about__badge { right: -50px; bottom: 40px; width: 150px; height: 150px; }
  }
</style>
