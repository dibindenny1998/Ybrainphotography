---
import Img from './Img.astro';
import { site, process } from '../data/site';
---
<section class="studio section" id="studio" aria-labelledby="studio-title">
  <div class="wrap studio__head">
    <p class="eyebrow"><span class="eyebrow__n">iv.</span>The studio</p>
    <h2 id="studio-title" class="display studio__title" data-split>A new studio,<br /><em>lamp-lit</em> &amp; ready<br />for you.</h2>
  </div>

  <div class="studio__collage wrap">
    <div class="studio__a" data-speed="0.92"><div class="studio__clip" data-clip-reveal><Img slot="studio-02" fit="cover" sizes="(min-width: 1024px) 55vw, 100vw" /></div></div>
    <div class="studio__b" data-speed="1.12"><div class="studio__clip" data-clip-reveal><Img slot="studio-03" fit="cover" sizes="(min-width: 1024px) 22vw, 45vw" /></div></div>
    <div class="studio__c" data-speed="1.04"><div class="studio__clip" data-clip-reveal><Img slot="studio-01" fit="cover" sizes="(min-width: 1024px) 24vw, 45vw" /></div></div>
    <p class="studio__stamp" aria-hidden="true" data-spin>
      <svg viewBox="0 0 200 200"><defs><path id="stamp-c" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs><text><textPath href="#stamp-c">NOW OPEN ✦ YBRAIN STUDIO ✦ KERALA ✦ EST. 2026 ✦ </textPath></text></svg>
      <span class="serif">2026</span>
    </p>
  </div>

  <div class="studio__body wrap">
    <div class="studio__copy">
      <p class="studio__big serif" data-fade-up>
        After years of photographing weddings across Kerala, Ybrain now has a home of its own — a calm,
        <em>daylit</em> studio for portraits, newborns and long conversations about your day.
      </p>
      <p class="studio__small" data-fade-up>
        Come see printed albums, sit for a portrait, or simply tell us about your families over a cup of chai. Newborn
        sessions happen in a warm, quiet room built for tiny guests — with everything sanitised, softened and slow.
      </p>
      <ul class="studio__facts">
        <li data-fade-up><span class="serif">{site.established}</span><span class="label">Studio opened</span></li>
        <li data-fade-up><span class="serif">14</span><span class="label">Districts we travel</span></li>
        <li data-fade-up><span class="serif">5</span><span class="label">Kinds of stories</span></li>
      </ul>
    </div>
    <ol class="studio__process">
      {process.map((p) => (
        <li class="step" data-fade-up>
          <span class="step__n serif">{p.n}</span>
          <div><h3 class="step__t serif">{p.title}</h3><p class="step__p">{p.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .studio__head { display: grid; gap: 28px; margin-bottom: clamp(48px, 8vw, 120px); }
  .studio__title { font-size: clamp(3rem, 10vw, 9rem); }

  .studio__collage { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; margin-bottom: clamp(64px, 10vw, 160px); }
  .studio__clip { overflow: hidden; border-radius: 3px; height: 100%; }
  .studio__clip .img { width: 100%; height: 100%; object-fit: cover; }
  .studio__a { grid-column: 1 / -1; aspect-ratio: 3 / 2; }
  .studio__b { grid-column: 1 / 7; aspect-ratio: 2 / 3; margin-top: -14%; z-index: 1; }
  .studio__b .studio__clip { border-radius: 999px 999px 3px 3px; outline: 6px solid var(--ivory); }
  .studio__c { grid-column: 7 / -1; aspect-ratio: 4 / 5; margin-top: 18%; }
  .studio__stamp { position: absolute; right: calc(var(--gutter) + 2%); top: -40px; width: 112px; height: 112px; margin: 0; display: grid; place-items: center; color: var(--red); z-index: 2; }
  .studio__stamp svg { position: absolute; inset: 0; overflow: visible; }
  .studio__stamp text { font-family: var(--sans); font-size: 15px; letter-spacing: 3.3px; fill: currentColor; font-weight: 500; }
  .studio__stamp .serif { font-style: italic; font-size: 22px; }
  .studio__stamp::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--ivory); z-index: -1; }

  .studio__body { display: grid; gap: 64px; }
  .studio__big { margin: 0 0 24px; font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.2; letter-spacing: -0.015em; }
  .studio__big em { color: var(--red); }
  .studio__small { margin: 0; color: var(--ink-2); max-width: 52ch; font-size: 15px; }
  .studio__facts { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .studio__facts li { display: grid; gap: 4px; padding: 20px 10px 0 0; }
  .studio__facts .serif { font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1; color: var(--red); font-style: italic; }
  .studio__facts .label { font-size: 9px; color: var(--ink-2); }

  .studio__process { list-style: none; margin: 0; padding: 0; counter-reset: s; }
  .step { display: grid; grid-template-columns: 56px 1fr; gap: 12px; padding: 24px 0; border-top: 1px solid var(--line); }
  .step:last-child { border-bottom: 1px solid var(--line); }
  .step__n { font-style: italic; color: var(--red); font-size: 20px; line-height: 1.2; }
  .step__t { margin: 0 0 6px; font-weight: 400; font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.1; }
  .step__p { margin: 0; color: var(--ink-2); font-size: 14px; max-width: 44ch; }

  @media (min-width: 1024px) {
    .studio__head { grid-template-columns: 220px 1fr; align-items: start; }
    .studio__collage { gap: 24px; }
    .studio__a { grid-column: 1 / 8; grid-row: 1 / 3; aspect-ratio: auto; height: 78vh; }
    .studio__b { grid-column: 8 / 11; grid-row: 1; margin-top: 12vh; aspect-ratio: 2 / 3; }
    .studio__c { grid-column: 10 / 13; grid-row: 2; margin-top: -10vh; aspect-ratio: 4 / 5; }
    .studio__stamp { top: auto; bottom: -6vh; left: 52%; right: auto; width: 150px; height: 150px; }
    .studio__body { grid-template-columns: 1.1fr 1fr; gap: 8vw; padding-left: calc(220px + 1px); }
  }
  @media (min-width: 1024px) and (max-width: 1279px) { .studio__body { padding-left: 0; } }
</style>
