---
import WhatsApp from './icons/WhatsApp.astro';
import { site } from '../data/site';
interface Props { title?: string }
const { title } = Astro.props;
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hello Ybrain, I would like to book a session.')}`;
---
<section class="cta space lit">
    <div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap cta__in">
    <span class="kicker" data-r>Bookings open</span>
    <h2 class="h2" data-r style="--d:.1s">{title ? <Fragment set:html={title} /> : <>Let's make something <em>to keep.</em></>}</h2>
    <div class="cta__acts" data-r style="--d:.2s">
      <a href={wa} target="_blank" rel="noopener" class="btn"><WhatsApp /> WhatsApp us</a>
      <a href={`tel:+91${site.phone}`} class="btn btn--line">Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>
<style is:global>
  .cta__in { display: grid; justify-items: center; text-align: center; gap: 30px; }
  .cta .h2 { max-width: 14ch; }
  .cta__acts { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 10px; }
</style>
