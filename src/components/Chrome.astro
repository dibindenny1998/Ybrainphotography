---
/** Preloader, navigation, menu, cursor and floating WhatsApp button */
import Logo from './Logo.astro';
import Img from './Img.astro';
import WhatsApp from './icons/WhatsApp.astro';
import { site } from '../data/site';
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi Ybrain! I would love to know more about your photography.')}`;
const links = [
  { href: '#work', label: 'Work', n: '01' },
  { href: '#stories', label: 'Stories', n: '02' },
  { href: '#about', label: 'About', n: '03' },
  { href: '#contact', label: 'Contact', n: '04' },
];
const flicks = ['couples-03', 'newborn-01', 'celebrations-01', 'maternity-01', 'weddings-05', 'portraits-01'];
---
<div class="loader" aria-hidden="true">
  <div class="loader__frame" data-loader-frame>
    {flicks.map((s, i) => <div class="loader__shot" data-loader-shot><Img slot={s} fit="cover" alt="" eager={i < 2} sizes="240px" /></div>)}
  </div>
  <div class="loader__brand"><Logo class="loader__logo" draw /></div>
  <div class="loader__count"><span data-loader-num>0</span><sup>%</sup></div>
  <div class="loader__bar"><i data-loader-bar></i></div>
</div>

<header class="nav" data-nav>
  <a href="#top" class="nav__logo" aria-label="Ybrain Photography — home"><Logo /></a>
  <nav class="nav__links" aria-label="Main">
    {links.slice(0, 3).map((l) => <a href={l.href} class="nav__link"><span data-t={l.label}>{l.label}</span></a>)}
  </nav>
  <div class="nav__right">
    <a href="#contact" class="btn btn--accent nav__cta" data-magnetic="0.25"><span class="btn__roll"><span data-t="Book a shoot">Book a shoot</span></span></a>
    <button class="nav__burger" aria-label="Open menu" aria-expanded="false" aria-controls="menu" data-menu-toggle><i></i><i></i></button>
  </div>
</header>

<div class="menu" id="menu" aria-hidden="true" data-menu>
  <div class="menu__bg"></div>
  <div class="menu__body">
    <ul class="menu__list">
      {links.map((l) => <li><a href={l.href} class="menu__link" data-menu-link><span class="menu__n">{l.n}</span><span class="menu__word">{l.label}</span></a></li>)}
    </ul>
    <div class="menu__foot">
      <a href={wa} target="_blank" rel="noopener" class="btn btn--accent"><WhatsApp class="btn__icon" /> WhatsApp us</a>
      <a href={site.instagram} target="_blank" rel="noopener" class="label">{site.instagramHandle}</a>
    </div>
  </div>
</div>

<div class="cursor" aria-hidden="true"><span class="cursor__label"></span></div>

<a href={wa} class="fab" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" data-fab><WhatsApp class="fab__icon" /></a>

<style is:global>
  /* loader */
  .loader { position: fixed; inset: 0; z-index: 200; background: var(--ink); color: var(--paper); display: none; }
  .js .loader { display: block; }
  .loader__frame { position: absolute; left: 50%; top: 50%; width: min(42vw, 220px); aspect-ratio: 4 / 5; transform: translate(-50%, -50%); overflow: hidden; border-radius: 4px; }
  .loader__shot { position: absolute; inset: 0; opacity: 0; }
  .loader__shot:first-child { opacity: 1; }
  .loader__shot .img { width: 100%; height: 100%; object-fit: cover; }
  .loader__brand { position: absolute; left: var(--gutter); top: max(22px, env(safe-area-inset-top)); width: 110px; color: var(--paper); }
  .loader__logo.logo path { stroke-width: 9; }
  .loader__count { position: absolute; right: var(--gutter); bottom: max(26px, env(safe-area-inset-bottom)); font-family: var(--serif); font-size: clamp(5rem, 16vw, 13rem); line-height: 0.8; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .loader__count sup { font-size: 0.3em; vertical-align: top; color: var(--accent); margin-left: 0.05em; }
  .loader__bar { position: absolute; left: var(--gutter); bottom: max(30px, env(safe-area-inset-bottom)); width: min(40vw, 260px); height: 2px; background: var(--line-d); }
  .loader__bar i { position: absolute; inset: 0; background: var(--accent); transform: scaleX(0); transform-origin: left; }

  /* logo */
  .logo { overflow: visible; }
  .logo path { fill: none; stroke: currentColor; stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; }
  .logo circle { fill: currentColor; }
  .logo--draw path { stroke-dasharray: 1; stroke-dashoffset: 1; }

  /* nav */
  .nav {
    position: fixed; z-index: 100; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 14px var(--gutter); padding-top: max(14px, env(safe-area-inset-top)); color: var(--paper);
    transition: transform 0.6s var(--ease), color 0.4s, background-color 0.4s;
  }
  .nav.is-hidden { transform: translateY(-110%); }
  .nav.is-solid { background: rgba(13, 12, 11, 0.92); }
  .nav-light .nav { color: var(--ink); }
  .nav-light .nav.is-solid { background: rgba(244, 241, 236, 0.94); box-shadow: 0 1px 0 var(--line); }
  .nav__logo { width: 92px; display: block; }
  .nav__links { display: none; gap: 36px; }
  .nav__link { display: inline-block; overflow: hidden; height: 1.4em; line-height: 1.4; font-size: 14px; font-weight: 500; }
  .nav__link span { display: block; position: relative; transition: transform 0.5s var(--ease); }
  .nav__link span::after { content: attr(data-t); position: absolute; left: 0; top: 100%; }
  .nav__link:hover span { transform: translateY(-100%); }
  .nav__right { display: flex; align-items: center; gap: 12px; }
  .nav__cta { --h: 42px; display: none; padding: 0 20px; }
  .nav__burger { position: relative; width: 44px; height: 44px; border-radius: 50%; background: var(--accent); z-index: 2; }
  .nav__burger i { position: absolute; left: 14px; width: 16px; height: 1.5px; background: var(--ink); transition: transform 0.5s var(--ease); }
  .nav__burger i:first-child { top: 18px; }
  .nav__burger i:last-child { top: 24px; }
  .menu-open .nav__burger i:first-child { transform: translateY(3px) rotate(45deg); }
  .menu-open .nav__burger i:last-child { transform: translateY(-3px) rotate(-45deg); }
  .menu-open .nav { color: var(--paper); background: transparent !important; box-shadow: none !important; }
  @media (min-width: 1024px) {
    .nav__links { display: flex; }
    .nav__cta { display: inline-flex; }
    .nav__burger { display: none; }
    .nav__logo { width: 104px; }
  }

  /* menu */
  .menu { position: fixed; inset: 0; z-index: 95; visibility: hidden; pointer-events: none; }
  .menu.is-open { visibility: visible; pointer-events: auto; }
  .menu__bg { position: absolute; inset: 0; background: var(--ink); transform: scaleY(0); transform-origin: top; }
  .menu__body { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 110px var(--gutter) max(30px, env(safe-area-inset-bottom)); color: var(--paper); }
  .menu__list { list-style: none; margin: 0; padding: 0; }
  .menu__list li { overflow: hidden; border-bottom: 1px solid var(--line-d); }
  .menu__link { display: flex; align-items: baseline; gap: 16px; padding: 8px 0; }
  .menu__n { font-size: 12px; color: var(--accent); font-weight: 600; }
  .menu__word { display: block; font-family: var(--serif); font-size: clamp(3.4rem, 16vw, 6rem); line-height: 1.02; letter-spacing: -0.02em; }
  .menu__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 24px; }

  /* cursor (desktop only) */
  .cursor { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .has-cursor .cursor {
      display: grid; place-items: center; position: fixed; left: 0; top: 0; z-index: 300; pointer-events: none;
      width: 84px; height: 84px; margin: -42px 0 0 -42px; border-radius: 50%; background: var(--accent); color: var(--ink);
      transform: scale(0); transition: transform 0.35s var(--ease-out);
    }
    .has-cursor .cursor.is-on { transform: scale(1); }
  }
  .cursor__label { font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }

  /* WhatsApp */
  .fab { position: fixed; z-index: 80; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--ink); box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.45); transform: scale(0); transition: transform 0.5s var(--ease-out); }
  .fab.is-on, html:not(.js) .fab { transform: scale(1); }
  .fab__icon { width: 26px; height: 26px; }
</style>
