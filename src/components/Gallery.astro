---
import Img from './Img.astro';
import { categories } from '../data/site';
import { category } from '../lib/photos';
const groups = await Promise.all(categories.map(async (c) => ({ ...c, photos: await category(c.id) })));
// interleave categories so "All" feels curated rather than grouped
const items: { cat: string; catName: string; p: (typeof groups)[number]['photos'][number] }[] = [];
const max = Math.max(...groups.map((g) => g.photos.length));
for (let i = 0; i < max; i++) for (const g of groups) if (g.photos[i]) items.push({ cat: g.id, catName: g.name, p: g.photos[i] });
---
<section class="gallery section" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery__head wrap">
    <p class="tag">Portfolio</p>
    <h2 id="gallery-title" class="display gallery__title" data-split>Selected <em>work</em></h2>
  </div>
  <div class="gallery__bar" data-filter-bar>
    <div class="gallery__filters wrap" role="tablist" aria-label="Filter portfolio by category">
      <button class="chip is-active" role="tab" aria-selected="true" data-filter="all">All <sup>{items.length}</sup></button>
      {groups.map((g) => <button class="chip" role="tab" aria-selected="false" data-filter={g.id}>{g.name} <sup>{g.photos.length}</sup></button>)}
    </div>
  </div>

  <div class="gallery__grid wrap" data-gallery>
    {items.map(({ cat, catName, p }, i) => (
      <figure class="gitem" data-cat={cat} data-gitem data-slot={p.slot}>
        <button class="gitem__btn" data-lightbox={i} data-cursor="View" aria-label={`Open ${p.caption}`}>
          <span class="gitem__media" data-reveal>
            <Img photo={p} sizes="(min-width: 1200px) 24vw, (min-width: 768px) 32vw, 48vw" />
          </span>
        </button>
        <figcaption class="gitem__cap"><span>{p.caption}</span><span class="muted">{catName}</span></figcaption>
      </figure>
    ))}
  </div>
</section>

<div class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true" data-lb>
  <div class="lightbox__bg" data-lb-close></div>
  <div class="lightbox__top wrap">
    <span class="lightbox__count"><span data-lb-index>01</span> / <span data-lb-total>{String(items.length).padStart(2, '0')}</span></span>
    <button class="lightbox__close" data-lb-close aria-label="Close">Close ✕</button>
  </div>
  <figure class="lightbox__figure">
    <div class="lightbox__frame" data-lb-frame><img alt="" data-lb-img /></div>
    <figcaption class="lightbox__cap"><span class="serif" data-lb-cap></span><span class="muted" data-lb-cat></span></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--prev" aria-label="Previous photo" data-lb-prev>←</button>
  <button class="lightbox__nav lightbox__nav--next" aria-label="Next photo" data-lb-next>→</button>
</div>

<style is:global>
  .gallery__head { display: grid; gap: 22px; margin-bottom: clamp(24px, 4vw, 48px); }
  .gallery__title { font-size: clamp(3.4rem, 10vw, 9rem); }
  .gallery__title em { color: var(--ink); background: linear-gradient(transparent 60%, var(--accent) 60%, var(--accent) 90%, transparent 90%); }
  .gallery__bar { position: sticky; top: 0; z-index: 40; padding-block: 12px; margin-bottom: clamp(18px, 3vw, 36px); background: var(--paper); transition: top 0.6s var(--ease); }
  .nav-shown .gallery__bar { top: var(--navh, 70px); }
  .gallery__filters { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .gallery__filters::-webkit-scrollbar { display: none; }
  .chip { flex: none; height: 40px; padding: 0 16px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); font-size: 13px; font-weight: 500; transition: background-color 0.3s, color 0.3s, box-shadow 0.3s; }
  .chip sup { font-size: 10px; color: var(--stone); margin-left: 2px; }
  .chip:hover { box-shadow: inset 0 0 0 1px var(--ink); }
  .chip.is-active { background: var(--ink); color: var(--paper); box-shadow: none; }
  .chip.is-active sup { color: var(--accent); }

  .gallery__grid { columns: 2; column-gap: 10px; }
  .gitem { break-inside: avoid; margin: 0 0 18px; }
  .gitem.is-hidden { display: none; }
  .gitem__btn { display: block; width: 100%; }
  .gitem__media { display: block; overflow: hidden; border-radius: 4px; background: var(--paper-2); }
  .gitem__media .img { transition: transform 1s var(--ease-out); }
  .gitem__btn:hover .img { transform: scale(1.04); }
  .gitem__cap { display: flex; justify-content: space-between; gap: 10px; padding-top: 8px; font-size: 13px; }
  .gitem__cap span:first-child { font-family: var(--serif); font-size: 17px; line-height: 1.2; }
  @media (max-width: 479px) { .gitem__cap .muted { display: none; } }
  @media (min-width: 768px) { .gallery__grid { columns: 3; column-gap: 18px; } .gitem { margin-bottom: 30px; } }
  @media (min-width: 1200px) { .gallery__grid { columns: 4; column-gap: 24px; } }
  @media (min-width: 1024px) { .gallery__filters { justify-content: flex-start; } }

  .lightbox { position: fixed; inset: 0; z-index: 150; display: grid; grid-template-rows: auto 1fr; visibility: hidden; pointer-events: none; color: var(--paper); }
  .lightbox.is-open { visibility: visible; pointer-events: auto; }
  .lightbox__bg { position: absolute; inset: 0; background: var(--ink); opacity: 0; }
  .lightbox__top { position: relative; display: flex; justify-content: space-between; align-items: center; height: 64px; padding-top: env(safe-area-inset-top); font-size: 13px; }
  .lightbox__close { color: var(--accent); font-weight: 600; padding: 10px 0; }
  .lightbox__figure { position: relative; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 4px var(--gutter) 90px; min-height: 0; }
  .lightbox__frame { min-height: 0; display: flex; justify-content: center; }
  .lightbox__frame img { max-width: 100%; max-height: calc(100svh - 180px); width: auto; height: auto; object-fit: contain; border-radius: 3px; }
  .lightbox__cap { display: flex; gap: 14px; align-items: baseline; font-size: 13px; }
  .lightbox__cap .serif { font-size: 22px; }
  .lightbox__nav { position: absolute; bottom: max(20px, env(safe-area-inset-bottom)); width: 54px; height: 54px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-d); font-size: 20px; transition: background 0.3s, color 0.3s; }
  .lightbox__nav:hover { background: var(--accent); color: var(--ink); box-shadow: none; }
  .lightbox__nav--prev { left: calc(50% - 64px); }
  .lightbox__nav--next { right: calc(50% - 64px); }
  @media (min-width: 1024px) {
    .lightbox__figure { padding-bottom: 36px; }
    .lightbox__frame img { max-height: calc(100svh - 140px); }
    .lightbox__nav { top: 50%; bottom: auto; margin-top: -27px; }
    .lightbox__nav--prev { left: var(--gutter); }
    .lightbox__nav--next { right: var(--gutter); }
  }
</style>
