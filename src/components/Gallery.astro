---
import Img from './Img.astro';
import { categories } from '../data/site';
import { category } from '../lib/photos';
const groups = await Promise.all(categories.map(async (c) => ({ ...c, photos: await category(c.id) })));
// interleave categories so "All" feels curated rather than grouped
const items: { cat: string; catName: string; p: (typeof groups)[number]['photos'][number] }[] = [];
const max = Math.max(...groups.map((g) => g.photos.length));
for (let i = 0; i < max; i++) for (const g of groups) if (g.photos[i]) items.push({ cat: g.id, catName: g.name, p: g.photos[i] });
---
<section class="gallery" id="gallery" aria-labelledby="gallery-title">
  <h2 id="gallery-title" class="sr-only">Portfolio</h2>
  <div class="gallery__bar" data-filter-bar>
    <div class="gallery__filters wrap" role="tablist" aria-label="Filter portfolio by category">
      <button class="chip is-active" role="tab" aria-selected="true" data-filter="all">All <sup>{items.length}</sup></button>
      {groups.map((g) => (
        <button class="chip" role="tab" aria-selected="false" data-filter={g.id}>{g.name} <sup>{g.photos.length}</sup></button>
      ))}
    </div>
  </div>

  <div class="gallery__grid wrap" data-gallery>
    {items.map(({ cat, catName, p }, i) => (
      <figure class:list={['gitem', `gitem--${p.orientation}`]} data-cat={cat} data-gitem>
        <button class="gitem__btn" data-lightbox={i} data-cursor="View" aria-label={`Open ${p.caption}`}>
          <span class="gitem__media" data-reveal-img>
            <Img photo={p} sizes="(min-width: 1200px) 24vw, (min-width: 768px) 45vw, 50vw" />
          </span>
        </button>
        <figcaption class="gitem__cap">
          <span class="serif">{p.caption}</span>
          <span class="label">{catName}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<!-- LIGHTBOX -->
<div class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true" data-lb>
  <div class="lightbox__bg" data-lb-close></div>
  <div class="lightbox__top wrap">
    <span class="label lightbox__count"><span data-lb-index>01</span> / <span data-lb-total>{String(items.length).padStart(2, '0')}</span></span>
    <button class="lightbox__close label" data-lb-close>Close <span aria-hidden="true">✕</span></button>
  </div>
  <figure class="lightbox__figure">
    <div class="lightbox__frame" data-lb-frame><img alt="" data-lb-img /></div>
    <figcaption class="lightbox__cap"><span class="serif" data-lb-cap></span><span class="label" data-lb-cat></span></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--prev" aria-label="Previous photo" data-lb-prev><svg viewBox="0 0 32 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M32 6H2M7 1 2 6l5 5"/></svg></button>
  <button class="lightbox__nav lightbox__nav--next" aria-label="Next photo" data-lb-next><svg viewBox="0 0 32 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M0 6h30M25 1l5 5-5 5"/></svg></button>
</div>

<style is:global>
  .gallery { position: relative; padding-bottom: clamp(80px, 12vw, 180px); }
  .gallery__bar { position: sticky; top: var(--navh, 72px); z-index: 40; padding-block: 12px; margin-bottom: clamp(20px, 4vw, 48px); transition: top 0.7s var(--ease); }
  .nav-hidden .gallery__bar { top: 0; }
  .gallery__bar { background: color-mix(in srgb, var(--ivory) 86%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .gallery__filters { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; }
  .gallery__filters::-webkit-scrollbar { display: none; }
  .chip {
    flex: none; height: 40px; padding: 0 18px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line);
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; scroll-snap-align: start;
    transition: background-color 0.4s var(--ease), color 0.4s, box-shadow 0.4s;
  }
  .chip sup { font-family: var(--serif); font-style: italic; letter-spacing: 0; font-size: 11px; color: var(--red); margin-left: 2px; transition: color 0.4s; }
  .chip:hover { box-shadow: inset 0 0 0 1px var(--red); }
  .chip.is-active { background: var(--velvet); color: #fff8f0; box-shadow: 0 6px 18px -8px rgba(158, 27, 50, 0.7); }
  .chip.is-active sup { color: var(--ivory); }

  .gallery__grid { columns: 2; column-gap: 12px; }
  .gitem { break-inside: avoid; margin: 0 0 22px; }
  .gitem.is-hidden { display: none; }
  .gitem__btn { display: block; width: 100%; text-align: left; }
  .gitem__media { display: block; overflow: hidden; border-radius: 3px; background: var(--ivory-2); }
  .gitem--portrait:nth-child(5n + 1) .gitem__media { border-radius: 999px 999px 3px 3px; }
  .gitem__media .img { transition: transform 1.2s var(--ease-out); }
  .gitem__btn:hover .img { transform: scale(1.045); }
  .gitem__cap { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding-top: 10px; }
  .gitem__cap .serif { font-size: 15px; font-style: italic; line-height: 1.2; }
  .gitem__cap .label { font-size: 9px; color: var(--ink-3); flex: none; }
  @media (max-width: 479px) { .gitem__cap .label { display: none; } }
  @media (min-width: 768px) { .gallery__grid { columns: 3; column-gap: 20px; } .gitem { margin-bottom: 36px; } .gitem__cap .serif { font-size: 17px; } }
  @media (min-width: 1200px) {
    .gallery__grid { columns: 4; column-gap: 28px; }
    .gitem:nth-child(4n + 2) { padding-inline: 8%; }
    .gitem:nth-child(7n + 3) { padding-inline: 4% 12%; }
  }
  @media (min-width: 1024px) { .gallery__filters { justify-content: center; } }

  /* lightbox */
  .lightbox { position: fixed; inset: 0; z-index: 150; display: grid; grid-template-rows: auto 1fr; visibility: hidden; pointer-events: none; }
  .lightbox.is-open { visibility: visible; pointer-events: auto; }
  .lightbox__bg { position: absolute; inset: 0; background: var(--ivory); opacity: 0; }
  .lightbox__top { position: relative; display: flex; justify-content: space-between; align-items: center; padding-block: max(18px, env(safe-area-inset-top)) 0; height: 64px; }
  .lightbox__close { display: inline-flex; gap: 10px; align-items: center; color: var(--red); padding: 10px 0; }
  .lightbox__count { color: var(--ink-2); }
  .lightbox__figure { position: relative; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 8px var(--gutter) 90px; min-height: 0; }
  .lightbox__frame { min-height: 0; display: flex; justify-content: center; overflow: hidden; border-radius: 3px; }
  .lightbox__frame img { max-width: 100%; max-height: calc(100svh - 190px); width: auto; height: auto; object-fit: contain; }
  .lightbox__cap { display: flex; gap: 16px; align-items: baseline; }
  .lightbox__cap .serif { font-style: italic; font-size: 20px; }
  .lightbox__cap .label { color: var(--ink-3); font-size: 10px; }
  .lightbox__nav { position: absolute; bottom: max(22px, env(safe-area-inset-bottom)); width: 56px; height: 56px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line); display: grid; place-items: center; color: var(--ink); transition: background 0.4s, color 0.4s; }
  .lightbox__nav svg { width: 22px; }
  .lightbox__nav:hover { background: var(--red); color: var(--ivory); box-shadow: none; }
  .lightbox__nav--prev { left: calc(50% - 68px); }
  .lightbox__nav--next { right: calc(50% - 68px); }
  @media (min-width: 1024px) {
    .lightbox__figure { padding-bottom: 40px; }
    .lightbox__frame img { max-height: calc(100svh - 150px); }
    .lightbox__nav { top: 50%; bottom: auto; margin-top: -28px; }
    .lightbox__nav--prev { left: var(--gutter); }
    .lightbox__nav--next { right: var(--gutter); }
  }
</style>
