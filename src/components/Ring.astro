---
/** A draggable 3D ring of photographs */
import Img from './Img.astro';
import { categories } from '../data/site';
import { category } from '../lib/photos';
const groups = await Promise.all(categories.map(async (c) => ({ name: c.name, photos: await category(c.id) })));
const picks: { p: any; cat: string }[] = [];
for (let i = 0; picks.length < 14 && i < 6; i++) for (const g of groups) if (g.photos[i] && picks.length < 14) picks.push({ p: g.photos[i], cat: g.name });
---
<section class="ring-sec" aria-labelledby="ring-title">
  <div class="ring-sec__head wrap">
    <p class="eyebrow"><span class="eyebrow__n">iii.</span><span data-scramble>The portfolio</span></p>
    <h2 id="ring-title" class="display ring-sec__title" data-split>The work,<br /><em>in the round.</em></h2>
  </div>
  <div class="ring-stage" data-ring-stage data-cursor="Drag" role="group" aria-label="Rotating ring of photographs — drag to spin, tap a photo to open it">
    <div class="ring" data-ring>
      {picks.map(({ p, cat }, i) => (
        <figure class="ring__card" data-ring-card={i} data-ring-slot={p.slot}>
          <Img photo={p} fit="cover" sizes="260px" />
          <figcaption><span class="serif">{p.caption}</span><span class="label">{cat}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="ring-stage__floor" aria-hidden="true"></div>
  </div>
  <p class="ring-sec__hint label wrap"><span>← Drag to spin →</span><span>Tap a photo to open</span></p>
</section>

<style is:global>
  .ring-sec { position: relative; padding-top: clamp(96px, 14vw, 180px); overflow: hidden; background: linear-gradient(180deg, var(--ivory) 0%, var(--ivory-2) 100%); }
  .ring-sec__head { display: grid; gap: 26px; position: relative; z-index: 2; }
  .ring-sec__title { font-size: clamp(3rem, 10vw, 9rem); }
  .ring-stage { position: relative; height: clamp(440px, 72vh, 760px); perspective: 1400px; perspective-origin: 50% 40%; touch-action: pan-y; user-select: none; margin-top: -2vh; }
  .ring-stage.is-dragging { cursor: grabbing; }
  .ring { position: absolute; left: 50%; top: 46%; width: 0; height: 0; transform-style: preserve-3d; will-change: transform; }
  .ring__card {
    --w: clamp(140px, 17vw, 250px);
    position: absolute; width: var(--w); aspect-ratio: 4 / 5; left: calc(var(--w) / -2); top: calc(var(--w) * -0.625); margin: 0;
    border-radius: 6px; overflow: visible; backface-visibility: visible; transform-style: preserve-3d;
  }
  .ring__card .img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; box-shadow: 0 30px 50px -24px rgba(60, 5, 15, 0.55); pointer-events: none; }
  .ring__card figcaption { position: absolute; left: 0; right: 0; top: calc(100% + 10px); display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .ring__card figcaption .serif { font-style: italic; font-size: 14px; }
  .ring__card figcaption .label { font-size: 8px; color: var(--ink-3); }
  .ring-stage__floor { position: absolute; left: 50%; bottom: 6%; width: 70vw; height: 90px; transform: translateX(-50%); background: radial-gradient(ellipse at center, rgba(176, 18, 47, 0.18), transparent 70%); filter: blur(10px); }
  .ring-sec__hint { display: flex; justify-content: space-between; color: var(--ink-3); padding-bottom: 40px; position: relative; z-index: 2; }
  .no-motion .ring-stage { height: auto; perspective: none; }
  .no-motion .ring { position: static; width: auto; height: auto; display: flex; gap: 12px; overflow-x: auto; padding: 0 var(--gutter); transform: none !important; }
  .no-motion .ring__card { position: relative; left: 0; top: 0; flex: none; transform: none !important; margin-bottom: 40px; }
</style>
