---
/** Full-screen photo viewer. Any element with data-lb-item (containing an <img>) opens it. */
---
<div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <div class="lb__bar wrap">
    <span data-lb-count></span>
    <button data-lb-close>Close</button>
  </div>
  <img alt="" />
  <p class="lb__cap" data-lb-cap></p>
  <button class="lb__nav lb__nav--p" data-lb-prev aria-label="Previous photo">Prev</button>
  <button class="lb__nav lb__nav--n" data-lb-next aria-label="Next photo">Next</button>
</div>
<style is:global>
  .lb { position: fixed; inset: 0; z-index: 90; background: rgba(23, 19, 16, 0.97); color: var(--night-text); display: grid; grid-template-rows: auto 1fr auto; justify-items: center; align-items: center; opacity: 0; transition: opacity 0.45s ease; }
  .lb.is-open { opacity: 1; }
  .lb[hidden] { display: none; }
  .lb__bar { display: flex; justify-content: space-between; width: 100%; height: 76px; align-items: center; font-size: 11px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; }
  .lb__bar button { font-weight: 600; letter-spacing: 0.24em; }
  .lb img { max-width: calc(100vw - 2 * var(--gutter)); max-height: calc(100svh - 170px); width: auto; height: auto; object-fit: contain; opacity: 0; transition: opacity 0.6s ease; }
  .lb img.on { opacity: 1; }
  .lb__cap { margin: 0; padding: 18px 0 max(30px, env(safe-area-inset-bottom)); font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--night-2); }
  .lb__nav { position: absolute; bottom: max(26px, env(safe-area-inset-bottom)); font-size: 11px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; padding: 10px; }
  .lb__nav--p { left: var(--gutter); }
  .lb__nav--n { right: var(--gutter); }
  @media (min-width: 1024px) { .lb__nav { top: 50%; bottom: auto; } }
</style>
