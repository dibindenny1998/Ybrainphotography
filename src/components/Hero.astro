---
import Img from './Img.astro';
import { heroSlides, categories } from '../data/site';
---
<section class="hero dark" id="top" data-theme="dark" aria-label="Introduction">
  <div class="hero__grid wrap">
    <div class="hero__text">
      <p class="tag hero__tag" data-hero-fade>Photography studio · Est. 2026</p>
      <h1 class="hero__title display" data-hero-title>
        <span class="line-mask"><span data-hero-line>Moments,</span></span>
        <span class="line-mask"><span data-hero-line><em>made</em></span></span>
        <span class="line-mask"><span data-hero-line>timeless.</span></span>
      </h1>
      <div class="hero__foot">
        <p class="hero__intro muted" data-hero-fade>
          Weddings, couples, maternity, newborn and portraits, photographed with honesty, warmth and a lot of light.
        </p>
        <div class="hero__ctas" data-hero-fade>
          <a href="#contact" class="btn btn--accent" data-magnetic="0.25"><span class="btn__roll"><span data-t="Book a shoot">Book a shoot</span></span></a>
          <a href="#work" class="btn btn--ghost"><span class="btn__roll"><span data-t="See the work">See the work</span></span></a>
        </div>
      </div>
    </div>

    <figure class="hero__show" data-hero-show data-cursor="Work">
      <div class="hero__slides" data-hero-slides>
        {heroSlides.map((s, i) => (
          <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-hero-slide>
            <Img slot={s.slot} fit="cover" eager={i === 0} sizes="(min-width: 1024px) 40vw, 92vw" />
          </div>
        ))}
      </div>
      <figcaption class="hero__cap">
        <span class="hero__count"><span data-hero-index>01</span> / {String(heroSlides.length).padStart(2, '0')}</span>
        <span class="hero__capt">
          {heroSlides.map((s, i) => <span class:list={['hero__capt-i', { 'is-active': i === 0 }]} data-hero-capt><em>{s.caption}</em> — {s.kind}</span>)}
        </span>
      </figcaption>
      <div class="hero__progress"><i data-hero-progress></i></div>
    </figure>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => (
        <div class="ticker__group">
          {categories.map((c) => <span class="ticker__item">{c.name}<i>✺</i></span>)}
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .hero { position: relative; overflow: hidden; padding-top: clamp(84px, 11vh, 120px); }
  .hero__grid { display: grid; gap: 28px; padding-bottom: clamp(28px, 5vh, 56px); }
  .hero__tag { color: var(--stone-2); }
  .hero__title { font-size: clamp(4.2rem, 19vw, 15rem); margin: 14px 0 0; line-height: 0.86; }
  .hero__title em { padding-right: 0.06em; }
  .hero::before { content: ''; position: absolute; right: -10vw; top: 10vh; width: 60vw; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(247, 161, 187, 0.28), transparent 65%); pointer-events: none; }
  .hero__slides { box-shadow: 0 40px 80px -40px rgba(90, 50, 90, 0.45); }
  .hero__title .line-mask { padding-bottom: 0.06em; }
  .hero__title [data-hero-line] { display: inline-block; }
  .hero__foot { display: grid; gap: 22px; margin-top: 22px; }
  .hero__intro { margin: 0; max-width: 34ch; font-size: 16px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .hero__show { margin: 0; position: relative; order: -1; }
  .hero__slides { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 6px; background: var(--ink-3); }
  .hero__slide { position: absolute; inset: 0; clip-path: inset(0 0 100% 0); }
  .hero__slide.is-active { clip-path: inset(0 0 0 0); z-index: 1; }
  .hero__slide .img { width: 100%; height: 100%; object-fit: cover; }
  .hero__cap { display: flex; justify-content: space-between; gap: 16px; padding-top: 12px; font-size: 13px; color: var(--stone-2); }
  .hero__count { font-variant-numeric: tabular-nums; color: var(--paper); font-weight: 500; }
  .hero__capt { position: relative; flex: 1; text-align: right; height: 1.6em; overflow: hidden; }
  .hero__capt-i { position: absolute; right: 0; top: 0; white-space: nowrap; opacity: 0; transform: translateY(100%); transition: opacity 0.5s, transform 0.6s var(--ease); }
  .hero__capt-i.is-active { opacity: 1; transform: none; }
  .hero__capt em { font-family: var(--serif); font-size: 1.15em; color: var(--paper); }
  .hero__progress { height: 2px; background: var(--line-d); margin-top: 10px; overflow: hidden; }
  .hero__progress i { display: block; height: 100%; background: var(--gold); transform: scaleX(0); transform-origin: left; }

  @media (max-width: 767px) {
    .hero__show { margin-inline: calc(var(--gutter) * -0.35); }
    .hero__slides { aspect-ratio: auto; height: 52svh; }
    .hero__title { font-size: clamp(3.6rem, 18vw, 6rem); }
  }
  @media (min-width: 1024px) {
    .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: space-between; }
    .hero__grid { grid-template-columns: 1.25fr 0.75fr; align-items: end; gap: 5vw; padding-bottom: 4vh; }
    .hero__show { order: 0; }
    .hero__slides { aspect-ratio: auto; height: min(72svh, 760px); }
    .hero__title { font-size: clamp(6rem, min(14vw, 23svh), 16rem); }
    .hero__foot { grid-template-columns: 1fr auto; align-items: end; margin-top: 4vh; }
  }

  /* marigold ticker */
  .ticker { background: var(--grad); color: #2a2131; overflow: hidden; padding-block: 16px; }
  .ticker__track { display: flex; width: max-content; animation: ticker 32s linear infinite; }
  .ticker__group { display: flex; flex: none; }
  .ticker__item { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--serif); font-size: clamp(1.6rem, 3.4vw, 2.8rem); line-height: 1.1; white-space: nowrap; }
  .ticker__item i { font-style: normal; font-size: 0.6em; }
  @keyframes ticker { to { transform: translateX(-50%); } }
</style>
