---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Arrow from '../components/icons/Arrow.astro';
import Cta from '../components/Cta.astro';
import { site, selected, stories, testimonials, categories, shoots, packages, founder } from '../data/site';
import { photo } from '../lib/photos';
const panelSlots = [
  ['portraits-02', 'couples-04', 'weddings-05'],
  ['couples-02', 'newborn-02', 'portraits-03'],
  ['weddings-01', 'couples-07', 'couples-01'],
];
const panels = await Promise.all(panelSlots.map((set) => Promise.all(set.map((s) => photo(s)))));
// the opening deck: the three panel covers first, then four more prints
const deck = [panels[0][0], panels[1][0], panels[2][0], ...(await Promise.all(['couples-03', 'newborn-01', 'celebrations-01', 'weddings-02'].map((s) => photo(s))))];
const shootsP = await Promise.all(shoots.map(async (x) => ({ ...x, p: await photo(x.cover) })));
const rollP = await Promise.all(['couples-01', 'newborn-05', 'portraits-03', 'weddings-01', 'maternity-05', 'couples-06', 'celebrations-04', 'newborn-08', 'portraits-02'].map((s) => photo(s)));
const gatherP = await Promise.all(['maternity-04', 'weddings-03', 'newborn-03', 'couples-05', 'portraits-01', 'celebrations-02', 'newborn-05', 'weddings-04'].map((s) => photo(s)));
const statement = 'We photograph people, not poses — the *glance* nobody planned, the *laugh* in the middle of a ritual, and the *light* that lasts only a minute.';
const words = statement.split(' ').map((w) => ({ t: w.replace(/\*/g, ''), em: w.includes('*') }));
---
<Base heroDark>
  <!-- HERO: three full-height photo panels (one on phones) -->
  <section class="hero" data-hero>
    <div class="hero__panels" data-panels>
      {panels.map((set, pi) => (
        <div class="hp" data-panel data-speed-p={['-12', '10', '-6'][pi]}>
          {set.map((p, i) => (
            <div class:list={['hp__s', { 'is-on': i === 0 }]} data-ps data-cap={p.caption}>
              <Img photo={p} fit="cover" eager={i === 0} sizes="(min-width: 700px) 34vw, 100vw" />
            </div>
          ))}
        </div>
      ))}
    </div>
    <div class="hero__shade"></div>
    <div class="hero__ui wrap">
      <span class="kicker hero__k" data-hero-fade>Photography · Thrissur, Kerala · Studio now open</span>
      <h1 class="hero__title" data-hero-title>
        <span class="hl"><span>Photographs</span></span>
        <span class="hl"><span>that feel like <em>you.</em></span></span>
      </h1>
      <div class="hero__acts" data-hero-fade>
        <a href="/portfolio/" class="btn" data-mag>View portfolio</a>
        <a href="/studio/" class="link hero__l">Visit the studio <Arrow /></a>
      </div>
    </div>
    <div class="hero__foot wrap" data-hero-fade>
      <span class="hero__scroll">Scroll</span>
      <div class="hero__bar"><i data-hero-bar></i></div>
      <span class="hero__cap" data-hero-cap>{panels[0][0].caption}</span>
    </div>

    <!-- opening sequence -->
    <div class="opening" data-intro aria-hidden="true">
      <div class="opening__bg" data-intro-bg><div class="blobs"><i></i><i></i><i></i></div></div>
      <div class="opening__deck" data-deck>
        {deck.map((p, i) => (
          <div class="card" data-card style={`z-index:${10 - i}`}>
            <Img photo={p} fit="cover" eager alt="" sizes={i < 3 ? '(min-width: 700px) 34vw, 100vw' : '240px'} />
          </div>
        ))}
      </div>
      <div class="opening__mark" data-intro-ui><span class="mark__name">YBRAIN</span><span class="mark__sub">Photography</span></div>
      <div class="opening__num" data-intro-ui><span data-intro-num>0</span><sup>%</sup></div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => <div class="ticker__g">{categories.map((c) => <span class="ticker__i">{c.name}<b>✦</b></span>)}<span class="ticker__i">The studio<b>✦</b></span></div>)}
    </div>
  </div>

  <!-- STATEMENT -->
  <section class="intro space">
    <div class="wrap">
      <p class="intro__text" data-words>
        {words.map((w) => <><span class:list={['w', { 'w--em': w.em }]}>{w.t}</span>{' '}</>)}
      </p>
    </div>
  </section>

  <!-- SELECTED -->
  <section class="sel">
    <div class="wrap">
      <div class="sel__head">
        <span class="kicker" data-r>Selected work</span>
        <a href="/portfolio/" class="link" data-r>Full portfolio <Arrow /></a>
      </div>
      <div class="sel__grid">
        {selected.map((s, i) => (
          <a href="/portfolio/" class:list={['sel__item', `sel__item--${i + 1}`]} data-cursor="View" data-speed={['0.94', '1.08', '0.98'][i]}>
            <div class="frame" data-ri><Img slot={s.slot} fit="cover" sizes="(min-width: 1024px) 34vw, 90vw" /></div>
            <div class="cap" data-r><span>No. 0{i + 1} — {s.title}</span><span>{s.kind}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- THE FOUNDER: scattered prints gather into a stack, then the founder's print steps forward -->
  <section class="fd" data-gather>
    <div class="fd__pin" data-gather-pin>
      <div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="fd__lead" data-gather-lead aria-hidden="true">Every photograph has <em>someone</em> behind it.</p>
      <div class="fd__stage" aria-hidden="true" data-gather-stage>
        {gatherP.map((p) => <div class="fd__p" data-gp><Img photo={p} fit="cover" alt="" sizes="220px" /></div>)}
      </div>
      <div class="wrap fd__in">
        <div class="fd__slot">
          <div class="fd__main" data-gp-main><Img slot={founder.photo} fit="cover" alt={`${founder.name}, ${founder.role.toLowerCase()} at Ybrain Photography`} sizes="(min-width: 1024px) 30vw, 60vw" /></div>
        </div>
        <div class="fd__text">
          <span class="kicker" data-gt>The founder</span>
          <h2 class="fd__name" data-gt>{founder.first} <em>{founder.last}</em></h2>
          <p class="fd__role" data-gt>{founder.role}</p>
          <p class="lede fd__lede" data-gt>{founder.short}</p>
          <a href="/about/" class="link" data-gt>About Ybrain <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE SHOOT: rows fill on hover, a photo follows the cursor -->
  <section class="shoots space-s lit-2">
    <div class="wrap">
      <div class="shoots__head">
        <span class="kicker" data-r>What we shoot</span>
        <h2 class="h2" data-split>Six ways to be <em>remembered.</em></h2>
      </div>
      <ul class="shoots__list" data-shoots>
        {shootsP.map((x, i) => (
          <li>
            <a href={`/portfolio/#${x.id}`} class="sh-row" data-shoot={x.id} data-cursor="View">
              <span class="sh-row__n">0{i + 1}</span>
              <span class="sh-row__name">{x.name}</span>
              <span class="sh-row__line muted">{x.line}</span>
              <span class="sh-row__thumb"><Img photo={x.p} fit="cover" alt="" sizes="80px" /></span>
              <Arrow class="sh-row__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="sh-float" aria-hidden="true" data-shoot-float>
      {shootsP.map((x) => <div class="sh-float__i" data-shoot-img={x.id}><Img photo={x.p} fit="cover" alt="" sizes="300px" /></div>)}
    </div>
  </section>

  <!-- STUDIO: the photo pulls back as you scroll -->
  <section class="stud night space">
    <div class="wrap stud__in">
      <div class="stud__text">
        <span class="kicker" data-r>The studio · Now open</span>
        <h2 class="h2" data-split>A home for <em>slow</em> sessions.</h2>
        <p class="lede" data-r>Since {site.studio.opened}, Ybrain has its own lamp-lit studio for maternity, baby and portrait shoots — a calm, warm space where nobody is in a hurry.</p>
        <a href="/studio/" class="btn" data-r data-mag>Visit the studio</a>
      </div>
      <div class="stud__img frame" data-ri data-cursor="Visit" data-zoomout><a href="/studio/" aria-label="Visit the studio"><Img slot="studio-01" fit="cover" sizes="(min-width: 1024px) 50vw, 92vw" /></a></div>
    </div>
  </section>

  <!-- STORIES: a film strip that slides sideways while pinned -->
  <section class="strip lit" data-strip>
    <div class="strip__pin">
      <div class="wrap strip__head">
        <span class="kicker" data-r>Stories</span>
        <h2 class="h2" data-split>Whole days, <em>kept whole.</em></h2>
        <a href="/stories/" class="link" data-r>All stories <Arrow /></a>
      </div>
      <div class="strip__vp" data-strip-vp>
        <div class="strip__track" data-strip-track>
          {stories.map((st, i) => (
            <a href={`/stories/${st.slug}/`} class="strip__card" data-cursor="Read">
              <div class="frame strip__img"><Img slot={st.cover} fit="cover" sizes="(min-width: 1024px) 30vw, 78vw" /></div>
              <div class="cap"><span>No. 0{i + 1} — {st.title}</span><span>{st.kind}</span></div>
            </a>
          ))}
        </div>
      </div>
      <div class="wrap"><div class="strip__bar"><i data-strip-bar></i></div></div>
    </div>
  </section>

  <!-- PRICING TEASER -->
  <section class="ptz space-s">
    <div class="wrap">
      <div class="ptz__head">
        <span class="kicker" data-r>Pricing</span>
        <h2 class="h2" data-split>Sessions, <em>simply</em> priced.</h2>
      </div>
      <div class="ptz__grid">
        {packages.map((pk, i) => (
          <div class:list={['pcard', { 'pcard--f': pk.featured }]} data-r data-tilt>
            <span class="pcard__note">{pk.note}</span>
            <span class="pcard__name">{pk.name}</span>
            <span class="pcard__from">from <b>{pk.from}</b></span>
            <ul class="pcard__inc">{pk.includes.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ROLLING PHOTO STRIP: drifts on its own, swipe it with a finger, rushes when you scroll -->
  <div class="roll" data-roll>
    <div class="roll__vp" data-roll-vp aria-label="More photographs — swipe to browse">
      <div class="roll__track">
        {[0, 1].map((k) => <div class="roll__g" aria-hidden={k === 1 ? 'true' : undefined}>{rollP.map((p) => <a href="/portfolio/" class="roll__i" tabindex={k === 1 ? -1 : undefined}><Img photo={p} fit="cover" alt={p.alt} sizes="260px" /></a>)}</div>)}
      </div>
    </div>
  </div>

  {testimonials.length > 0 && (
    <section class="words space-s">
      <div class="wrap words__in">
        <span class="kicker" data-r>Kind words</span>
        <blockquote class="words__q" data-r>“{testimonials[0].quote}”</blockquote>
        <span class="cap" data-r><span>{testimonials[0].name} · {testimonials[0].kind}</span></span>
      </div>
    </section>
  )}

  <Cta />
</Base>

<style>
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; background: var(--night); color: var(--night-text); }
  .hero__panels { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr; gap: 0; }
  .hp { position: relative; overflow: hidden; }
  .hp:nth-child(n + 2) { display: none; }
  .hp__s { position: absolute; inset: -6% 0; clip-path: inset(100% 0 0 0); }
  .hp__s.is-on { clip-path: inset(0 0 0 0); }
  .hp__s .img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 700px) {
    .hero__panels { grid-template-columns: repeat(3, 1fr); gap: 6px; background: var(--night); }
    .hp:nth-child(n + 2) { display: block; }
  }
  .hero__shade { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(36, 24, 24, 0.5) 0%, rgba(36, 24, 24, 0) 24%, rgba(36, 24, 24, 0.15) 45%, rgba(36, 24, 24, 0.86) 100%), linear-gradient(90deg, rgba(36, 24, 24, 0.45) 0%, rgba(36, 24, 24, 0) 60%); }
  .hero__ui { position: absolute; left: 0; right: 0; bottom: clamp(90px, 15vh, 150px); display: grid; gap: 26px; justify-items: start; z-index: 2; }
  .hero__k { color: rgba(246, 238, 243, 0.85); }
  .hero__title { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(3.3rem, 10vw, 10.5rem); line-height: 0.95; letter-spacing: -0.035em; text-shadow: 0 10px 50px rgba(20, 10, 25, 0.35); }
  .hero__title em { font-style: italic; color: #f7c2b0; }
  .hl { display: block; overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.08em; }
  .hl > span { display: inline-block; }
  .hero__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 30px; }
  .hero__l { color: var(--night-text); }
  .hero__foot { position: absolute; left: 0; right: 0; bottom: max(26px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 22px; z-index: 2; font-size: 10.5px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(246, 238, 243, 0.8); }
  .hero__bar { flex: 1; height: 1.5px; background: rgba(246, 238, 243, 0.2); overflow: hidden; }
  .hero__bar i { display: block; height: 100%; background: var(--grad); transform: scaleX(0); transform-origin: left; }
  .hero__cap { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 15px; letter-spacing: 0; text-transform: none; }

  /* opening sequence */
  .opening { display: none; }
  :global(.js) .opening { display: block; position: fixed; inset: 0; z-index: 200; }
  .opening__bg { position: absolute; inset: 0; background: var(--light); background-color: var(--paper); overflow: hidden; }
  .opening__deck { position: absolute; inset: 0; }
  .card { position: absolute; left: 50%; top: 50%; width: min(46vw, 230px); aspect-ratio: 4 / 5; margin: calc(min(46vw, 230px) * -0.625) 0 0 calc(min(46vw, 230px) * -0.5); overflow: hidden; border-radius: 5px; box-shadow: 0 30px 60px -28px rgba(70, 30, 70, 0.55); border: 5px solid #fff; background: #fff; }
  .card .img { width: 100%; height: 100%; object-fit: cover; }
  .opening__mark { position: absolute; left: var(--gutter); top: 30px; display: grid; gap: 7px; line-height: 1; color: var(--umber); }
  .opening__num { position: absolute; right: var(--gutter); bottom: max(22px, env(safe-area-inset-bottom)); font-family: var(--serif); font-weight: 300; font-size: clamp(4.5rem, 13vw, 11rem); line-height: 0.8; letter-spacing: -0.04em; color: var(--umber); font-variant-numeric: tabular-nums; }
  .opening__num sup { font-size: 0.28em; vertical-align: top; color: var(--rose); }
  :global(.no-intro) .opening { display: none !important; }

  .intro__text { margin: 0 auto; max-width: 22ch; text-align: center; font-family: var(--serif); font-weight: 300; font-size: clamp(2rem, 4.2vw, 4rem); line-height: 1.15; letter-spacing: -0.015em; }
  .w--em { font-style: italic; color: var(--rose); }

  .sel { padding-bottom: clamp(110px, 15vw, 220px); }
  .sel__head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: clamp(40px, 6vw, 80px); }
  .sel__grid { display: grid; gap: 70px; }
  .sel__item { display: block; }
  .sel__item .frame { aspect-ratio: 4 / 5; }
  @media (min-width: 900px) {
    .sel__grid { grid-template-columns: repeat(12, 1fr); gap: 0 2vw; align-items: start; }
    .sel__item--1 { grid-column: 1 / 6; }
    .sel__item--2 { grid-column: 7 / 11; margin-top: 20vw; }
    .sel__item--3 { grid-column: 3 / 9; margin-top: 8vw; }
    .sel__item--3 .frame { aspect-ratio: 4 / 3.6; }
  }

  /* founder moment */
  .fd__pin { position: relative; height: 100svh; min-height: 600px; overflow: hidden; background: linear-gradient(160deg, #ffe6d5 0%, #fbcdbf 52%, #f3b6c1 100%); }
  .fd__pin .blobs i { opacity: 0.55; }
  .fd__lead, .fd__stage { display: none; }
  .fd__in { position: relative; z-index: 2; height: 100%; display: grid; align-content: center; justify-items: center; gap: 26px; text-align: center; }
  .fd__slot { width: min(52vw, 250px); }
  .fd__main { aspect-ratio: 4 / 5; overflow: hidden; border: 6px solid #fff; border-radius: 6px; background: #fff; box-shadow: 0 40px 80px -36px rgba(110, 40, 50, 0.55); will-change: transform; }
  .fd__main .img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .fd__text { display: grid; gap: 12px; justify-items: center; max-width: 46ch; }
  .fd__name { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(2.6rem, 6vw, 6rem); line-height: 1; letter-spacing: -0.03em; }
  .fd__name em { font-style: italic; color: var(--rose); }
  .fd__role { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: var(--umber); opacity: 0.7; }
  .fd__lede { color: #5b4643; font-size: 15px; }
  .fd .kicker { color: #8a5d58; }
  @media (max-width: 699px) { .fd__lede { font-size: 14px; line-height: 1.6; } }
  @media (min-width: 1024px) {
    .fd__in { grid-template-columns: 0.9fr 1.1fr; justify-items: start; text-align: left; gap: 7vw; align-items: center; }
    .fd__slot { width: min(30vw, 440px); justify-self: end; }
    .fd__text { justify-items: start; gap: 18px; }
    .fd__lede { font-size: 1.1rem; }
  }
  :global(.js) .fd__stage { display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  :global(.js) .fd__lead { display: block; position: absolute; z-index: 3; left: 50%; top: 50%; width: min(88vw, 15ch); margin: 0; transform: translate(-50%, -50%); text-align: center; font-family: var(--serif); font-weight: 300; font-size: clamp(2.3rem, 5.6vw, 5.4rem); line-height: 1.04; letter-spacing: -0.025em; pointer-events: none; }
  .fd__lead em { font-style: italic; color: var(--rose); }
  .fd__p { position: absolute; left: 50%; top: 50%; width: var(--cw); aspect-ratio: 4 / 5; margin: calc(var(--cw) * -0.625) 0 0 calc(var(--cw) * -0.5); overflow: hidden; border: 5px solid #fff; border-radius: 5px; background: #fff; box-shadow: 0 30px 60px -28px rgba(110, 40, 50, 0.5); will-change: transform; }
  .fd { --cw: clamp(110px, 14vw, 210px); }
  .fd__p .img { width: 100%; height: 100%; object-fit: cover; }

  .shoots__head { display: grid; gap: 24px; margin-bottom: clamp(40px, 6vw, 80px); }
  .shoots__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .shoots__list li { border-bottom: 1px solid var(--line); overflow: hidden; }
  .sh-row { position: relative; display: grid; grid-template-columns: 36px 1fr auto; grid-template-areas: 'n name thumb' 'n line thumb'; align-items: center; column-gap: 14px; padding: 20px 0; isolation: isolate; transition: color 0.4s; }
  .sh-row::before { content: ''; position: absolute; inset: 0 calc(var(--gutter) * -1); z-index: -1; background: var(--grad); transform: scaleY(0); transform-origin: bottom; transition: transform 0.6s var(--ease); }
  .sh-row__n { grid-area: n; align-self: start; padding-top: 1em; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; color: var(--rose); }
  .sh-row__name { grid-area: name; font-family: var(--serif); font-weight: 300; font-size: clamp(2.4rem, 7vw, 5.6rem); line-height: 1.02; letter-spacing: -0.02em; transition: transform 0.7s var(--ease); }
  .sh-row__line { grid-area: line; font-size: 14px; }
  .sh-row__thumb { grid-area: thumb; display: block; width: 60px; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 4px; }
  .sh-row__thumb .img { width: 100%; height: 100%; object-fit: cover; }
  .sh-row__arrow { display: none; }
  .sh-float { display: none; }
  @media (min-width: 1024px) {
    .sh-row { grid-template-columns: 70px minmax(0, 1fr) 360px 40px; grid-template-areas: 'n name line arrow'; padding: 22px 0; }
    .sh-row__thumb { display: none; }
    .sh-row__arrow { display: block; grid-area: arrow; width: 26px; justify-self: end; transition: transform 0.6s var(--ease); }
    .sh-row:hover::before { transform: scaleY(1); }
    .sh-row:hover .sh-row__name { transform: translateX(16px); font-style: italic; }
    .sh-row:hover .sh-row__line, .sh-row:hover .sh-row__n { color: var(--umber); }
    .sh-row:hover .sh-row__arrow { transform: translateX(4px) rotate(-45deg); }
    .sh-float { display: block; position: fixed; left: 0; top: 0; z-index: 60; width: 250px; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 6px; pointer-events: none; opacity: 0; transform: scale(0.6); box-shadow: 0 30px 60px -24px rgba(60, 30, 30, 0.55); }
    .sh-float__i { position: absolute; inset: 0; opacity: 0; transition: opacity 0.35s; }
    .sh-float__i.on { opacity: 1; }
    .sh-float__i .img { width: 100%; height: 100%; object-fit: cover; }
  }

  .stud { overflow: hidden; }
  .stud__in { display: grid; gap: 56px; align-items: center; }
  .stud__text { display: grid; gap: 28px; justify-items: start; }
  .stud__img { aspect-ratio: 3 / 2; }
  .stud__img a { display: block; height: 100%; }
  @media (min-width: 1024px) { .stud__in { grid-template-columns: 0.8fr 1.2fr; gap: 7vw; } }

  .strip { padding-block: clamp(90px, 12vw, 160px); }
  .strip__head { display: grid; gap: 22px; justify-items: start; margin-bottom: clamp(36px, 5vw, 64px); }
  .strip__vp { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .strip__vp::-webkit-scrollbar { display: none; }
  .strip__track { display: flex; gap: 18px; width: max-content; padding-inline: var(--gutter); }
  .strip__card { flex: none; width: min(78vw, 420px); scroll-snap-align: start; }
  .strip__img { aspect-ratio: 4 / 5; }
  .strip__bar { height: 1.5px; background: var(--line); margin-top: 36px; overflow: hidden; }
  .strip__bar i { display: block; height: 100%; background: var(--rose); transform: scaleX(0); transform-origin: left; }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .strip__vp { overflow: visible; }
  }
  @media (min-width: 1024px) {
