---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Arrow from '../components/icons/Arrow.astro';
import Cta from '../components/Cta.astro';
import { site, heroPhotos, selected, stories, testimonials } from '../data/site';
import { photo } from '../lib/photos';
const slides = await Promise.all(heroPhotos.map((s) => photo(s)));
const feature = stories[1];
---
<Base>
  <!-- HERO -->
  <section class="hero lit">
    <div class="wrap hero__in">
      <div class="hero__text">
        <span class="kicker" data-r>Photography · Kerala</span>
        <h1 class="h1" data-r style="--d:.1s">Photographs that feel like <em>you.</em></h1>
        <p class="lede" data-r style="--d:.2s">Weddings, couples, maternity, newborn and portraits. Unhurried, honest, and full of light.</p>
        <a href="/portfolio/" class="link" data-r style="--d:.3s">View portfolio <Arrow /></a>
      </div>
      <figure class="hero__fig" data-r style="--d:.15s">
        <div class="hero__frame frame">
          {slides.map((p, i) => (
            <div class:list={['hero__slide', { 'is-on': i === 0 }]} data-slide data-cap={p.caption}>
              <Img photo={p} fit="cover" eager={i === 0} sizes="(min-width: 1024px) 34vw, 88vw" />
            </div>
          ))}
        </div>
        <figcaption class="cap"><span data-slide-cap>{slides[0].caption}</span><span>Selected work</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro space">
    <div class="wrap">
      <p class="intro__text" data-r>
        We photograph people, not poses — the glance nobody planned, the laugh in the middle of a ritual,
        and the light that lasts only a minute.
      </p>
    </div>
  </section>

  <!-- SELECTED -->
  <section class="sel">
    <div class="wrap">
      <div class="sel__head">
        <span class="kicker" data-r>Selected work</span>
        <a href="/portfolio/" class="link" data-r>Full portfolio <Arrow /></a>
      </div>
      <div class="sel__grid">
        {selected.map((s, i) => (
          <a href="/portfolio/" class:list={['sel__item', `sel__item--${i + 1}`]}>
            <div class="frame" data-ri style={`--d:${i * 0.12}s`}><Img slot={s.slot} fit="cover" sizes="(min-width: 1024px) 34vw, 90vw" /></div>
            <div class="cap" data-r><span>No. 0{i + 1} — {s.title}</span><span>{s.kind}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STUDIO -->
  <section class="stud night space">
    <div class="wrap stud__in">
      <div class="stud__text">
        <span class="kicker" data-r>The studio · Now open</span>
        <h2 class="h2" data-r style="--d:.1s">A home for <em>slow</em> sessions.</h2>
        <p class="lede" data-r style="--d:.2s">Since {site.studio.opened}, Ybrain has its own lamp-lit studio for maternity, baby and portrait shoots — a calm, warm space where nobody is in a hurry.</p>
        <a href="/studio/" class="link" data-r style="--d:.3s">Visit the studio <Arrow /></a>
      </div>
      <div class="stud__img frame" data-ri><Img slot="studio-01" fit="cover" sizes="(min-width: 1024px) 50vw, 92vw" /></div>
    </div>
  </section>

  <!-- STORY -->
  <section class="feat space">
    <div class="wrap feat__in">
      <a href={`/stories/${feature.slug}/`} class="feat__img"><div class="frame" data-ri><Img slot={feature.cover} fit="cover" sizes="(min-width: 1024px) 52vw, 92vw" /></div></a>
      <div class="feat__text">
        <span class="kicker" data-r>A story · {feature.kind}</span>
        <h2 class="h2" data-r style="--d:.1s">{feature.title}</h2>
        <p class="lede" data-r style="--d:.2s">{feature.intro} {feature.text}</p>
        <div class="feat__links" data-r style="--d:.3s">
          <a href={`/stories/${feature.slug}/`} class="link">Read the story <Arrow /></a>
          <a href="/stories/" class="link">All stories <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="words space-s">
      <div class="wrap words__in">
        <span class="kicker" data-r>Kind words</span>
        <blockquote class="words__q" data-r>“{testimonials[0].quote}”</blockquote>
        <span class="cap" data-r><span>{testimonials[0].name} · {testimonials[0].kind}</span></span>
      </div>
    </section>
  )}

  <Cta />
</Base>

<style>
  .hero { padding-top: clamp(130px, 16vw, 190px); padding-bottom: clamp(70px, 9vw, 120px); }
  .hero__in { display: grid; gap: 64px; align-items: center; }
  .hero__text { display: grid; gap: 30px; justify-items: start; }
  .hero__text .h1 { max-width: 11ch; }
  .hero__fig { margin: 0; }
  .hero__frame { position: relative; aspect-ratio: 4 / 5; }
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 2.2s ease; }
  .hero__slide.is-on { opacity: 1; }
  @media (min-width: 1024px) {
    .hero { min-height: 100svh; display: flex; align-items: center; }
    .hero__in { grid-template-columns: 1.15fr 0.85fr; gap: 8vw; }
    .hero__fig { max-width: 520px; justify-self: end; width: 100%; }
  }

  .intro__text { margin: 0 auto; max-width: 24ch; text-align: center; font-family: var(--serif); font-weight: 300; font-size: clamp(1.8rem, 3.6vw, 3.4rem); line-height: 1.2; letter-spacing: -0.01em; }

  .sel { padding-bottom: clamp(110px, 16vw, 240px); }
  .sel__head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: clamp(40px, 6vw, 80px); }
  .sel__grid { display: grid; gap: 70px; }
  .sel__item { display: block; }
  .sel__item .frame { aspect-ratio: 4 / 5; }
  @media (min-width: 900px) {
    .sel__grid { grid-template-columns: repeat(12, 1fr); gap: 0 2vw; align-items: start; }
    .sel__item--1 { grid-column: 1 / 6; }
    .sel__item--2 { grid-column: 7 / 11; margin-top: 22vw; }
    .sel__item--3 { grid-column: 3 / 9; margin-top: 8vw; }
    .sel__item--3 .frame { aspect-ratio: 4 / 3.6; }
  }

  .stud__in { display: grid; gap: 56px; align-items: center; }
  .stud__text { display: grid; gap: 28px; justify-items: start; }
  .stud__img { aspect-ratio: 3 / 2; }
  @media (min-width: 1024px) { .stud__in { grid-template-columns: 0.8fr 1.2fr; gap: 7vw; } }

  .feat__in { display: grid; gap: 50px; align-items: center; }
  .feat__img .frame { aspect-ratio: 4 / 3.4; }
  .feat__text { display: grid; gap: 26px; justify-items: start; }
  .feat__links { display: flex; flex-wrap: wrap; gap: 30px; }
  @media (min-width: 1024px) { .feat__in { grid-template-columns: 1.2fr 0.8fr; gap: 7vw; } }

  .words__in { display: grid; justify-items: center; text-align: center; gap: 26px; }
  .words__q { margin: 0; max-width: 30ch; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1.3; }
</style>
