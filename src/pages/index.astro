---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Ring from '../components/Ring.astro';
import Gallery from '../components/Gallery.astro';
import Stories from '../components/Stories.astro';
import Studio from '../components/Studio.astro';
import Enquire from '../components/Enquire.astro';
---
<Base>
  <Chrome />
  <canvas class="gl-media" data-gl-media aria-hidden="true"></canvas>
  <main>
    <Hero />
    <Intro />
    <Ring />
    <Gallery />
    <Stories />
    <Studio />
    <Enquire />
  </main>
  <script>
    import '../scripts/main';
  </script>
</Base>
