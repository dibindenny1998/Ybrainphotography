---
import Base from '../layouts/Base.astro';
import Arrow from '../components/icons/Arrow.astro';
---
<Base title="Page not found">
  <section class="phead lit nf">
    <div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap nf__in">
      <span class="kicker">404</span>
      <h1 class="h1">This frame <em>wasn't taken.</em></h1>
      <a href="/" class="link">Back home <Arrow /></a>
    </div>
  </section>
</Base>
<style>.nf { min-height: 80svh; } .nf__in { display: grid; gap: 30px; justify-items: start; }</style>
